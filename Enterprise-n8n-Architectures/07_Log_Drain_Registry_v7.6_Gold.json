[{"updatedAt":"2026-05-08T04:38:48.840Z","createdAt":"2026-04-25T19:14:19.192Z","id":"FEK7PNwR6I3XZygD","name":"Log-Drain — Centralized Sub-workflow","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"log-drain","responseMode":"responseNode","options":{}},"id":"874cb754-32a3-4452-b7ec-b2ea164cd99a","name":"Webhook Trigger","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[544,352],"webhookId":"54b4aff7-ebfe-462b-8f98-10dfb2ff05e6","onError":"continueRegularOutput"},{"parameters":{"jsCode":"const input = $input.first().json;\nconst raw = input.body ?? input;\n\n// 1. Level Detection\nlet level = raw.level;\nif (!level) {\n  if (raw.status === 'ERROR' || raw.error || (raw.execution && raw.execution.error)) level = 'error';\n  else if (raw.message === 'Done' || raw.status === 'SUCCESS' || raw.status === 'success') level = 'success';\n  else level = 'info';\n}\n\nconst validLevels = ['debug', 'info', 'warn', 'error', 'success'];\nconst finalLevel = validLevels.includes(level) ? level : 'info';\n\n// 2. Extraction\nconst workflowName = String(raw.workflow_name || (raw.workflow && raw.workflow.name) || 'unknown').slice(0, 100);\nconst toolName = raw.tool_name ? String(raw.tool_name).slice(0, 100) : (raw.execution && raw.execution.lastNodeExecuted ? String(raw.execution.lastNodeExecuted) : 'n/a');\nconst message = String(raw.message || (raw.execution && raw.execution.error ? raw.execution.error.message : '') || 'No message provided').slice(0, 2000);\n\n// Resilient Metadata Extraction\nlet metadata = {};\nif (raw.metadata && typeof raw.metadata === 'object' && raw.metadata !== null) {\n  metadata = raw.metadata;\n} else {\n  const { body, headers, ...cleanRaw } = raw;\n  metadata = cleanRaw;\n}\n\n// Strip empty keys from metadata to prevent Supabase/PostgREST errors\nconst cleanMetadata = {};\nObject.entries(metadata).forEach(([k, v]) => {\n  if (k && typeof k === 'string' && k.trim() !== \"\" && k !== \"undefined\") {\n    cleanMetadata[k] = v;\n  }\n});\n\nconst sessionId = raw.session_id ? String(raw.session_id).slice(0, 100) : (raw.execution ? String(raw.execution.id) : 'n/a');\n\nconst entry = {\n  workflow_name: workflowName,\n  tool_name:     toolName,\n  level:         finalLevel,\n  message:       message,\n  metadata:      cleanMetadata,\n  session_id:    sessionId,\n  created_at:    raw.ts || (raw.execution && raw.execution.error && raw.execution.error.timestamp ? new Date(raw.execution.error.timestamp).toISOString() : new Date().toISOString()),\n};\n\nreturn [{ json: entry }];\n"},"id":"c814c347-6c9c-4e5a-ad89-11bed2935e0d","name":"Normalize Entry","type":"n8n-nodes-base.code","typeVersion":2,"position":[784,352]},{"parameters":{"conditions":{"combinator":"and","conditions":[{"id":"cond-1777360836465-9b4kubpyi","leftValue":"={{ $json.level }}","operator":{"operation":"notEquals","type":"string"},"rightValue":"debug"}],"options":{"version":2,"leftValue":"","caseSensitive":false,"typeValidation":"none"}},"options":{}},"id":"6aed7496-eded-4266-8f7a-d3ae219ef21c","name":"Is Non-Debug?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1024,352],"onError":"continueErrorOutput"},{"parameters":{"chatId":"7392899748","text":"={{ $json.level === 'error' ? '🚨 *ERROR*' : ($json.level === 'warn' ? '⚠️ *WARNING*' : ($json.level === 'success' ? '✅ *SUCCESS*' : 'ℹ️ *INFO*')) }} in `{{ $json.workflow_name }}`\n*Tool:* `{{ $json.tool_name ?? 'n/a' }}`\n*Message:* {{ $json.message }}\n*Time:* {{ $json.created_at }}\n*Session:* `{{ $json.session_id ?? 'n/a' }}`","additionalFields":{"parse_mode":"Markdown"}},"id":"55abf308-aa05-4b5d-a072-d8ad2999d4e6","name":"Telegram Alert","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1264,208],"maxTries":3,"retryOnFail":true,"waitBetweenTries":2000,"webhookId":"8c09eb9c-35cf-4689-8f95-ffade3fea0e5","credentials":{"telegramApi":{"id":"lMh5dlTVHK0LmmG6","name":"Telegram Account Memory Vault"}},"onError":"continueRegula