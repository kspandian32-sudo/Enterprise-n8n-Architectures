    {
      "parameters": {
        "jsCode": "// Calculate week number for each active client\nconst items = $input.all();\nconst now = Date.now();\n\nif (items.length === 0) return [];\n\nreturn items.map(item => {\n  const onboardedAt = item.json['timestamp'];\n  let weekNum = 1;\n  if (onboardedAt) {\n    const daysSince = Math.floor((now - new Date(onboardedAt).getTime()) / (24 * 60 * 60 * 1000));\n    weekNum = Math.max(1, Math.ceil(daysSince / 7));\n  }\n  return { json: { ...item.json, weekNumber: weekNum } };\n});"
      },
      "id": "547d6510-cf21-4462-be73-de75c5351756",
      "name": "\ud83d\udd22 Calculate Week Number",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        1056
      ]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "seconds"
      },
      "id": "wait-checkin-id",
      "name": "Wait (10s) - Check-In",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
